---
/**
 * Vídeo da abertura: mudo, em repetição, decorativo (aria-hidden), com botão de pausa visível (WCAG 2.2.2).
 * Leveza: o HTML traz só a capa (WebP). O vídeo NÃO é baixado no carregamento: o script o busca depois que a
 * página terminou de carregar, na versão de 480p (celular) ou 720p, em WebM ou, se o navegador não souber, MP4.
 * Com "reduzir movimento", economia de dados ou conexão lenta, fica a capa e o vídeo só carrega se a pessoa tocar.
 */
import { temWebm, temMp4, temWebmSm, temMp4Sm, temPosterHero } from '../lib/midia';
---
<video class="hv__v" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"
  poster={temPosterHero ? '/videos/hero-poster.webp' : undefined} data-hero-video
  data-webm={temWebm ? '/videos/hero.webm' : undefined} data-mp4={temMp4 ? '/videos/hero.mp4' : undefined}
  data-sm-webm={temWebmSm ? '/videos/hero-sm.webm' : undefined} data-sm-mp4={temMp4Sm ? '/videos/hero-sm.mp4' : undefined}></video>
<button class="hv__btn" type="button" data-hero-btn>Pausar vídeo</button>
<script>
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const btn = document.querySelector<HTMLButtonElement>('[data-hero-btn]');
  if (v && btn) {
    const reduzMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const con = (navigator as any).connection;
    const poupar = !!con && (con.saveData === true || /(^|-)(2g|3g)$/.test(con.effectiveType ?? ''));
    const rotulo = (tocando: boolean) => { btn.textContent = tocando ? 'Pausar vídeo' : 'Reproduzir vídeo'; };

    // escolhe o arquivo: 480p em tela pequena; WebM se o navegador toca VP9, senão MP4
    const carregar = () => {
      if (v.getAttribute('src')) return;
      const d = v.dataset;
      const pequeno = matchMedia('(max-width: 61.99rem)').matches;
      const webm = v.canPlayType('video/webm; codecs="vp9"') !== '';
      const ordem = pequeno
        ? (webm ? [d.smWebm, d.smMp4, d.webm, d.mp4] : [d.smMp4, d.smWebm, d.mp4, d.webm])
        : (webm ? [d.webm, d.mp4, d.smWebm, d.smMp4] : [d.mp4, d.webm, d.smMp4, d.smWebm]);
      const url = ordem.find(Boolean);
      if (url) { v.src = url; v.load(); }
    };
    const tocar = () => { carregar(); return v.play().then(() => rotulo(true)).catch(() => rotulo(false)); };

    if (reduzMovimento || poupar) rotulo(false);
    else {
      // só depois de a página (texto, fontes e fotos) terminar de carregar
      const quandoOcioso = () => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(tocar, { timeout: 2500 }) : setTimeout(tocar, 400));
      if (document.readyState === 'complete') quandoOcioso(); else addEventListener('load', quandoOcioso, { once: true });
    }
    btn.addEventListener('click', () => { if (v.paused) tocar(); else { v.pause(); rotulo(false); } });
  }
</script>
<style>
  .hv__v { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hv__btn {
    position: absolute; z-index: 2; right: var(--hv-pad, .75rem); bottom: var(--hv-pad, .75rem);
    min-height: 2.75rem; padding: .55rem 1.1rem; border: 1px solid rgb(255 255 255 / .6); border-radius: var(--raio); cursor: pointer;
    background: rgb(0 0 0 / .55); color: var(--branco);
    font: 600 var(--t-mini) / 1 var(--f-texto); letter-spacing: .18em; text-transform: uppercase;
    transition: background-color .3s var(--ease), color .3s var(--ease);
  }
  @media (max-width: 61.99rem) { .hv__btn { top: calc(var(--hv-pad, .75rem) + 2.9rem); bottom: auto; } }
  @media (hover: hover) { .hv__btn:hover { background: var(--branco); color: var(--preto); } }
</style>
