---
/**
 * Vídeo da abertura: mudo, em repetição, decorativo (aria-hidden), com botão de pausa visível (WCAG 2.2.2).
 * Com "reduzir movimento", economia de dados ou conexão lenta, fica a capa e o botão permite tocar.
 */
import { temWebm, temMp4, temPosterHero } from '../lib/midia';
---
<video class="hv__v" muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1"
  poster={temPosterHero ? '/videos/hero-poster.jpg' : undefined} data-hero-video>
  {temWebm && <source src="/videos/hero.webm" type="video/webm" />}
  {temMp4 && <source src="/videos/hero.mp4" type="video/mp4" />}
</video>
<button class="hv__btn" type="button" data-hero-btn>Pausar vídeo</button>
<script>
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const btn = document.querySelector<HTMLButtonElement>('[data-hero-btn]');
  if (v && btn) {
    const reduzMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const con = (navigator as any).connection;
    const poupar = !!con && (con.saveData === true || /(^|-)(2g|3g)$/.test(con.effectiveType ?? ''));
    const rotulo = (tocando: boolean) => { btn.textContent = tocando ? 'Pausar vídeo' : 'Reproduzir vídeo'; };
    const tocar = () => v.play().then(() => rotulo(true)).catch(() => rotulo(false));
    if (reduzMovimento || poupar) rotulo(false); else tocar();
    btn.addEventListener('click', () => { if (v.paused) tocar(); else { v.pause(); rotulo(false); } });
  }
</script>
<style>
  .hv__v { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hv__btn {
    position: absolute; z-index: 2; right: .75rem; bottom: .75rem;
    min-height: 2.75rem; padding: .55rem 1.1rem; border: 1px solid rgb(255 255 255 / .6); border-radius: var(--raio); cursor: pointer;
    background: rgb(0 0 0 / .55); color: var(--branco);
    font: 600 var(--t-mini) / 1 var(--f-texto); letter-spacing: .18em; text-transform: uppercase;
    transition: background-color .3s var(--ease), color .3s var(--ease);
  }
  @media (hover: hover) { .hv__btn:hover { background: var(--branco); color: var(--preto); } }
</style>
