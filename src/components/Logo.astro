---
// Logo oficial (public/logo-santina.png): 500 x 500 px, fundo preto #000000, sem transparência.
// NÃO é alterada: o arquivo vai inteiro; o recorte abaixo só esconde a margem preta em volta, por CSS.
// Usar sempre sobre superfície #000000, senão aparece um retângulo (ver DESIGN.md).
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { negocio } from '../conteudo/ativo';
interface Props { largura?: string }
const { largura = '10rem' } = Astro.props;
const temLogo = existsSync(join(process.cwd(), 'public', negocio.logo));
---
{temLogo
  ? <span class="logo" style={`--w:${largura}`}><img src={negocio.logo} alt={negocio.logoAlt} width="500" height="500" decoding="async" /></span>
  : <span class="logo logo--texto">{negocio.nome}</span>}
<style>
  /* conteúdo da logo: x 24 a 475, y 182 a 363 (de 500). Janela com 6 px de folga: 464 x 193. */
  .logo { position: relative; display: block; width: var(--w); aspect-ratio: 464 / 193; overflow: hidden; background: var(--preto); }
  .logo img { position: absolute; max-width: none; height: auto; width: calc(500 / 464 * 100%); left: calc(-18 / 464 * 100%); top: calc(-176 / 193 * 100%); }
  .logo--texto { aspect-ratio: auto; width: auto; color: var(--branco); font: 400 1.5rem/1.1 var(--f-titulo); }
</style>
