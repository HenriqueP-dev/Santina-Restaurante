---
// Barra fixa no celular: reservar pelo WhatsApp e ligar sempre à mão.
import { negocio } from '../conteudo/ativo';
---
<div class="ligar sec--escura">
  <a class="ligar__a ligar__a--wa" href="/#reservas">Reservar</a>
  <a class="ligar__a" href={negocio.telefoneLink}><span class="ligar__t">Ligar</span> <span class="ligar__n num">{negocio.telefone}</span></a>
</div>
<style>
  .ligar { display: none; }
  @media (max-width: 62rem) {
    .ligar { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: auto 1fr; min-height: 3.75rem; background: var(--preto); border-top: 1px solid rgb(255 255 255 / .22); }
    .ligar__a { display: flex; align-items: center; justify-content: center; gap: .6rem; padding: 0 1.25rem; min-height: 3.75rem; color: var(--branco); text-decoration: none; font: 600 var(--t-mini)/1 var(--f-texto); letter-spacing: .2em; text-transform: uppercase; }
    .ligar__a--wa { background: var(--verde); }
    .ligar__n { letter-spacing: .06em; font-weight: 500; font-size: .85rem; }
  }
</style>
