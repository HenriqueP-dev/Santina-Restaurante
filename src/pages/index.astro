---
import Base from '../layouts/Base.astro';
import Quadro from '../components/Quadro.astro';
import Icone from '../components/Icone.astro';
import ReservaMesa from '../components/ReservaMesa.astro';
import HeroVideo from '../components/HeroVideo.astro';
import { temVideoHero } from '../lib/midia';
import { negocio, servicos, avaliacao, textos } from '../conteudo/ativo';
const t = textos;
---
<Base>
  <!-- ABERTURA: quadro de foto ou vídeo em tela cheia; título e ações sobre ele -->
  <section class="hero sec--escura" aria-labelledby="h-hero">
    <div class="hero__fundo" data-hero-quadro>
      {temVideoHero
        ? <><HeroVideo /><p class="hero__legenda">{t.hero.legendaVideo}</p></>
        : <Quadro rotulo={t.hero.quadro} proporcao="auto" />}
    </div>
    <div class="hero__veu" aria-hidden="true"></div>
    <div class="container hero__conteudo">
      <h1 id="h-hero" data-hero-item>{t.hero.titulo}</h1>
      <p class="lead" data-hero-item>{t.hero.lead}</p>
      <div class="hero__acoes" data-hero-item>
        <a class="btn btn--verde" href="#reservas">{t.hero.reservar}</a>
        <a class="btn btn--linha" href="/cardapio/">{t.hero.cardapio}</a>
      </div>
    </div>
  </section>

  <!-- NOSSA HISTÓRIA -->
  <section class="section" id="historia" aria-labelledby="h-hist">
    <div class="container hist">
      <div class="hist__foto" data-revelar><Quadro rotulo={t.historia.quadroFachada} proporcao="4 / 5" /></div>
      <div class="hist__txt" data-revelar>
        <p class="rotulo">{t.historia.rotulo}</p>
        <h2 id="h-hist">{t.historia.titulo}</h2>
        <span class="filete" aria-hidden="true"></span>
        {t.historia.texto.map((p) => <p class="lead">{p}</p>)}
        <p class="pendente">{t.historia.pendente}</p>
        <Quadro rotulo={t.historia.quadroInterior} proporcao="3 / 2" />
      </div>
    </div>
  </section>

  <!-- EXPERIÊNCIA GASTRONÔMICA -->
  <section class="section sec--creme" aria-labelledby="h-exp">
    <div class="container">
      <div class="exp__topo" data-revelar>
        <div>
          <p class="rotulo">{t.experiencia.rotulo}</p>
          <h2 id="h-exp">{t.experiencia.titulo}</h2>
        </div>
        <div class="exp__lead">
          <p class="lead">{t.experiencia.lead}</p>
          <p class="sec-txt">{t.experiencia.extras}</p>
          <a class="btn" href="/cardapio/">{t.experiencia.botao}</a>
        </div>
      </div>
      <ul class="exp__trio">
        {t.experiencia.destaques.map((d, i) => (
          <li class={`dest dest--${i + 1}`} data-revelar>
            <Quadro rotulo={d.quadro} proporcao={i === 1 ? '3 / 2' : '4 / 5'} />
            <p class="dest__cat tracado">{d.categoria}</p>
            <p class="dest__nome">{d.prato}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- O AMBIENTE -->
  <section class="section" aria-labelledby="h-amb">
    <div class="container">
      <div class="amb__topo" data-revelar>
        <p class="rotulo">{t.ambiente.rotulo}</p>
        <h2 id="h-amb">{t.ambiente.titulo}</h2>
        <p class="lead">{t.ambiente.lead}</p>
      </div>
      <div class="amb__grade">
        {t.ambiente.quadros.map((q, i) => <Quadro rotulo={q.rotulo} foto={q.foto} alt={q.alt} ilustrativa={q.foto ? t.ambiente.etiqueta : undefined} proporcao={['3 / 2', '4 / 5', '1 / 1', '3 / 2'][i]} class={`amb__q amb__q--${i + 1}`} />)}
      </div>
    </div>
  </section>

  <!-- AVALIAÇÕES -->
  <section class="section sec--escura av" aria-labelledby="h-av">
    <div class="container av__in">
      <h2 id="h-av" class="sr-only">{t.avaliacoes.tituloLeitor}</h2>
      <p class="mega num" data-revelar>Nota <span class="mega__nota">{avaliacao.nota}</span> em {avaliacao.total} avaliações no {avaliacao.fonte}.</p>
      <div class="temas" data-revelar>
        {avaliacao.temas.map((tm) => (
          <div class="tema"><h3 class="tema__t tracado">{tm.titulo}</h3><ul>{tm.itens.map((i) => <li>{i}</li>)}</ul></div>
        ))}
      </div>
      <p class="sec-txt av__fonte">{t.avaliacoes.nota}</p>
    </div>
  </section>

  <!-- RESERVAS -->
  <section class="section sec--creme" id="reservas" aria-labelledby="h-res">
    <div class="container res">
      <div class="res__txt" data-revelar>
        <p class="rotulo">{t.reservas.rotulo}</p>
        <h2 id="h-res">{t.reservas.titulo}</h2>
        <p class="lead">{t.reservas.lead}</p>
      </div>
      <div class="res__form" data-revelar><ReservaMesa /></div>
    </div>
  </section>

  <!-- LOCALIZAÇÃO E CONTATO -->
  <section class="section" id="local" aria-labelledby="h-loc">
    <div class="container loc">
      <div class="loc__txt" data-revelar>
        <p class="rotulo">{t.local.rotulo}</p>
        <h2 id="h-loc">{negocio.endereco}</h2>
        <address>
          <p class="lead">{negocio.bairro}, {negocio.cidade}, {negocio.uf}<br />CEP {negocio.cep}</p>
          <a class="loc__tel num" href={negocio.telefoneLink}>{negocio.telefone}</a>
          <div class="loc__acoes">
            <a class="btn btn--linha" href={negocio.mapaLink} target="_blank" rel="noopener">{t.local.mapa}<span class="sr-only"> (abre em nova aba)</span></a>
            <a class="link" href={negocio.instagramUrl} target="_blank" rel="noopener">Instagram {negocio.instagram}<span class="sr-only"> (abre em nova aba)</span></a>
          </div>
        </address>
      </div>
      <div class="loc__info" data-revelar>
        <h3 class="loc__h tracado">{t.local.horarios}</h3>
        <p class="loc__nota">{t.local.horariosNota}</p>
        <h3 class="loc__h tracado">{t.local.servicos}</h3>
        <ul class="serv">
          {servicos.map((s) => <li><Icone nome={s.id} class="serv__i" /><span>{s.nome}</span></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- abertura ---------- */
  .hero { position: relative; display: grid; align-items: end; min-height: max(34rem, calc(100svh - 7.5rem)); overflow: hidden; }
  .hero__fundo { position: absolute; inset: 0; }
  .hero__fundo :global(.quadro) { position: absolute; inset: 0; height: 100%; border-radius: 0; aspect-ratio: auto !important; }
  .hero__fundo :global(.quadro__in) { place-content: start end; justify-items: end; text-align: right; padding: 2rem 2.2rem; }
  .hero__fundo :global(.quadro__t) { max-width: 30ch; font-size: 1rem; }
  .hero__legenda { position: absolute; z-index: 2; left: var(--gutter); top: 1rem; margin: 0; padding: .4rem .7rem; background: rgb(0 0 0 / .65); color: var(--branco); font-size: .75rem; font-weight: 600; letter-spacing: .02em; line-height: 1.2; border-radius: var(--raio); max-width: none; }
  .hero__veu { position: absolute; inset: 0; background: linear-gradient(to top, rgb(0 0 0 / .86), rgb(0 0 0 / .45) 55%, rgb(0 0 0 / .1)); }
  .hero__conteudo { position: relative; z-index: 1; padding-block: 3rem clamp(3rem, 6vw, 4.75rem); display: grid; gap: 1.4rem; justify-items: start; }
  .hero h1 { max-width: 19ch; }
  .hero .lead { margin: 0; max-width: 40ch; color: rgb(255 255 255 / .92); }
  .hero__acoes { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: .4rem; }
  @media (max-width: 61.99rem) { .hero { min-height: max(32rem, calc(100svh - 12.5rem)); } }

  /* ---------- história ---------- */
  .hist { display: grid; gap: 2.5rem; align-items: start; }
  .hist__txt { display: grid; gap: 1.1rem; justify-items: start; }
  .hist__txt .lead { margin: 0; }
  .hist__txt :global(.quadro) { width: 100%; margin-top: 1rem; }
  .hist__txt .filete { margin: .25rem 0 .4rem; }
  .pendente { margin: .2rem 0 0; padding: .7rem 1rem; border-left: 3px solid var(--vermelho); font-size: .9rem; color: var(--texto-2); }
  @media (min-width: 62rem) { .hist { grid-template-columns: 5fr 6fr; gap: 6rem; } .hist__foto { position: sticky; top: calc(var(--hd-h) + 2rem); } }

  /* ---------- experiência ---------- */
  .exp__topo { display: grid; gap: 1.75rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .exp__lead { display: grid; gap: 1rem; justify-items: start; align-content: end; }
  .exp__lead p { margin: 0; }
  .exp__trio { display: grid; gap: 2.5rem; }
  .dest { display: grid; gap: .35rem; align-content: start; }
  .dest__cat { margin: .9rem 0 0; color: var(--verde-texto); }
  .dest__nome { margin: 0; font: 400 var(--t-h3)/1.2 var(--f-titulo); color: var(--tinta); max-width: 22ch; }
  @media (min-width: 62rem) {
    .exp__topo { grid-template-columns: 1.1fr .9fr; gap: 6rem; align-items: end; }
    .exp__trio { grid-template-columns: 1fr 1.35fr 1fr; gap: 2.5rem; align-items: end; }
    .dest--2 { align-self: start; }
  }

  /* ---------- ambiente ---------- */
  .amb__topo { display: grid; gap: .5rem; margin-bottom: clamp(2rem, 4vw, 3rem); justify-items: start; }
  .amb__topo .lead { margin: .5rem 0 0; }
  .amb__grade { display: grid; gap: 1rem; }
  @media (min-width: 52rem) {
    .amb__grade { grid-template-columns: repeat(12, 1fr); gap: 1.25rem; align-items: start; }
    .amb__grade :global(.amb__q--1) { grid-column: 1 / span 7; }
    .amb__grade :global(.amb__q--2) { grid-column: 8 / span 5; }
    .amb__grade :global(.amb__q--3) { grid-column: 1 / span 4; }
    .amb__grade :global(.amb__q--4) { grid-column: 5 / span 8; }
  }

  /* ---------- avaliações ---------- */
  .av { padding-block: clamp(4.5rem, 10vw, 9rem); }
  .av__in { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  .mega { margin: 0; max-width: 20ch; font: 400 clamp(2.6rem, 1.1rem + 6vw, 6.25rem)/1.03 var(--f-titulo); color: var(--branco); text-wrap: balance; }
  .mega__nota { color: var(--verde-claro); }
  .temas { display: grid; gap: 2rem; border-top: 1px solid rgb(255 255 255 / .25); padding-top: 1.75rem; position: relative; }
  .temas::before { content: ''; position: absolute; left: 0; top: -2px; width: 4.5rem; height: 3px; background: linear-gradient(90deg, var(--verde) 0 33.3%, var(--branco) 33.3% 66.6%, var(--vermelho) 66.6% 100%); }
  .tema__t { margin: 0 0 .9rem; font-family: var(--f-texto); font-size: var(--t-mini); line-height: 1; color: var(--verde-claro); }
  .tema li { padding: .45rem 0; font: 400 1.3rem/1.3 var(--f-titulo); color: var(--branco); }
  .av__fonte { margin: 0; font-size: .875rem; max-width: 70ch; }
  @media (min-width: 52rem) { .temas { grid-template-columns: repeat(3, 1fr); gap: 3rem; } }

  /* ---------- reservas ---------- */
  .res { display: grid; gap: 2.5rem; align-items: start; }
  .res__txt { display: grid; gap: 1rem; justify-items: start; }
  .res__txt .lead { margin: 0; max-width: 34ch; }
  @media (min-width: 62rem) { .res { grid-template-columns: .8fr 1.2fr; gap: 6rem; } .res__txt { position: sticky; top: calc(var(--hd-h) + 2rem); } }

  /* ---------- localização e contato ---------- */
  .loc { display: grid; gap: 3rem; align-items: start; }
  .loc address { font-style: normal; display: grid; gap: 1.2rem; justify-items: start; margin-top: 1.5rem; }
  .loc address .lead { margin: 0; }
  .loc__tel { display: inline-block; min-height: 2.75rem; font: 400 clamp(2.1rem, 1.5rem + 2.6vw, 3.6rem)/1.1 var(--f-titulo); text-decoration: none; color: var(--tinta); }
  @media (hover: hover) { .loc__tel { transition: color .3s var(--ease); } .loc__tel:hover { color: var(--verde-texto); } }
  .loc__acoes { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  .loc__h { margin: 0 0 .8rem; color: var(--tinta); font-family: var(--f-texto); font-size: var(--t-mini); line-height: 1; }
  .loc__info > .loc__h ~ .loc__h { margin-top: 2.25rem; }
  .loc__nota { margin: 0; color: var(--texto-2); max-width: 44ch; padding-top: .9rem; border-top: 1px solid var(--areia); }
  .serv { display: grid; border-top: 1px solid var(--areia); }
  .serv li { display: flex; align-items: center; gap: 1.1rem; padding: 1rem 0; border-bottom: 1px solid var(--areia); font: 400 1.35rem/1.2 var(--f-titulo); color: var(--tinta); }
  .serv :global(.serv__i) { width: 1.75rem; height: 1.75rem; color: var(--verde-texto); flex: none; }
  @media (min-width: 62rem) { .loc { grid-template-columns: 1fr 1fr; gap: 7rem; } }
</style>
