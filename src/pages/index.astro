---
import Base from '../layouts/Base.astro';
import Quadro from '../components/Quadro.astro';
import Icone from '../components/Icone.astro';
import ReservaMesa from '../components/ReservaMesa.astro';
import HeroVideo from '../components/HeroVideo.astro';
import { temVideoHero } from '../lib/midia';
import { negocio, servicos, avaliacao, textos, cardapio } from '../conteudo/ativo';
const cat = (id: string) => cardapio.find((c) => c.id === id)!;
const t = textos;
---
<Base>
  <!-- ABERTURA: palco preto. Texto direto sobre o preto (sem véu); o vídeo vai numa janela com o contorno da placa da logo -->
  <section class="hero sec--escura" aria-labelledby="h-hero">
    <div class="container hero__grade">
      <div class="hero__conteudo">
        <h1 id="h-hero" data-hero-item>{t.hero.titulo}</h1>
        <p class="lead" data-hero-item>{t.hero.lead}</p>
        <div class="hero__acoes" data-hero-item>
          <a class="btn btn--verde" href="#reservas">{t.hero.reservar}</a>
          <a class="btn btn--linha" href="/cardapio/">{t.hero.cardapio}</a>
        </div>
      </div>
      <div class="hero__janela placa" data-hero-quadro>
        <div class="hero__midia">
          {temVideoHero
            ? <><HeroVideo /><p class="hero__legenda">{t.hero.legendaVideo}</p></>
            : <Quadro rotulo={t.hero.quadro} proporcao="auto" />}
        </div>
      </div>
    </div>
  </section>

  <!-- NOSSA HISTÓRIA -->
  <section class="section sec--ampla" id="historia" aria-labelledby="h-hist">
    <div class="container hist">
      <div class="hist__foto" data-revelar><Quadro rotulo={t.historia.fachada.rotulo} foto={t.historia.fachada.foto} alt={t.historia.fachada.alt} ilustrativa={t.historia.fachada.foto ? t.historia.etiqueta : undefined} proporcao="4 / 5" /></div>
      <div class="hist__txt" data-revelar>
        <h2 id="h-hist">{t.historia.titulo}</h2>
        {t.historia.texto.map((p) => <p class="lead">{p}</p>)}
        <Quadro rotulo={t.historia.interior.rotulo} foto={t.historia.interior.foto} alt={t.historia.interior.alt} ilustrativa={t.historia.interior.foto ? t.historia.etiqueta : undefined} proporcao="3 / 2" />
      </div>
    </div>
  </section>

  <!-- EXPERIÊNCIA GASTRONÔMICA: sumário da carta (índice com contagem) ao lado de três fotos escalonadas -->
  <section class="section sec--creme" aria-labelledby="h-exp">
    <div class="container exp">
      <div class="exp__txt" data-revelar>
        <h2 id="h-exp">{t.experiencia.titulo}</h2>
        <p class="lead">{t.experiencia.lead}</p>
        <ol class="carta" aria-label="Categorias do cardápio">
          {cardapio.map((c) => (
            <li><a class="carta__l" href={`/cardapio/#${c.id}`}><span class="carta__n">{c.nome}</span><span class="carta__p num-sans">{c.pratos.length} pratos</span></a></li>
          ))}
        </ol>
        <p class="sec-txt exp__extra">{t.experiencia.extras}</p>
        <a class="btn" href="/cardapio/">{t.experiencia.botao}</a>
      </div>
      <ul class="exp__fotos">
        {t.experiencia.destaques.map((d, i) => (
          <li class={`dest dest--${i + 1}`} data-revelar>
            <Quadro rotulo={cat(d.categoriaId).nome} foto={d.foto} alt={d.alt} posicao={d.posicao} ilustrativa={d.foto ? textos.cardapio.etiqueta : undefined} proporcao={['4 / 5', '3 / 2', '3 / 2'][i]} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- O AMBIENTE: o texto é uma célula do mosaico, não um cabeçalho em cima dele -->
  <section class="section sec--compacta" aria-labelledby="h-amb">
    <div class="container amb__grade">
      <div class="amb__txt" data-revelar>
        <h2 id="h-amb">{t.ambiente.titulo}</h2>
        <p class="lead">{t.ambiente.lead}</p>
      </div>
      {t.ambiente.quadros.map((q, i) => <Quadro rotulo={q.rotulo} foto={q.foto} alt={q.alt} ilustrativa={q.foto ? t.ambiente.etiqueta : undefined} proporcao={['3 / 2', '4 / 5', '1 / 1', '3 / 2'][i]} class={`amb__q amb__q--${i + 1}`} />)}
    </div>
  </section>

  <!-- AVALIAÇÕES -->
  <section class="section sec--escura av" aria-labelledby="h-av">
    <div class="container av__in">
      <h2 id="h-av" class="sr-only">{t.avaliacoes.tituloLeitor}</h2>
      <div class="placa av__placa" data-revelar>
        <p class="mega">Nota <span class="mega__nota num-sans">{avaliacao.nota}</span> em <span class="num-sans">{avaliacao.total}</span> avaliações no {avaliacao.fonte}.</p>
      </div>
      <div class="temas" data-revelar>
        {avaliacao.temas.map((tm) => (
          <div class="tema"><h3 class="tema__t tracado">{tm.titulo}</h3><ul>{tm.itens.map((i) => <li>{i}</li>)}</ul></div>
        ))}
      </div>
      <p class="sec-txt av__fonte">{t.avaliacoes.nota}</p>
    </div>
  </section>

  <!-- RESERVAS -->
  <section class="section sec--creme" id="reservas" aria-labelledby="h-res">
    <div class="container res">
      <div class="res__txt" data-revelar>
        <h2 id="h-res">{t.reservas.titulo}</h2>
        <p class="lead">{t.reservas.lead}</p>
      </div>
      <div class="res__form placa" data-revelar><ReservaMesa /></div>
    </div>
  </section>

  <!-- LOCALIZAÇÃO E CONTATO -->
  <section class="section" id="local" aria-labelledby="h-loc">
    <div class="container loc">
      <div class="loc__txt" data-revelar>
        <div class="lockup">
          <h2 id="h-loc">{negocio.endereco}</h2>
          <span class="filete" aria-hidden="true"></span>
          <p class="tracado loc__desc">{t.local.descritor}</p>
        </div>
        <address>
          <p class="lead">CEP {negocio.cep}</p>
          <a class="loc__tel num-sans" href={negocio.telefoneLink}>{negocio.telefone}</a>
          <div class="loc__acoes">
            <a class="btn btn--linha" href={negocio.mapaLink} target="_blank" rel="noopener">{t.local.mapa}<span class="sr-only"> (abre em nova aba)</span></a>
            <a class="link" href={negocio.instagramUrl} target="_blank" rel="noopener">Instagram {negocio.instagram}<span class="sr-only"> (abre em nova aba)</span></a>
          </div>
        </address>
      </div>
      <div class="loc__info" data-revelar>
        <h3 class="loc__h tracado">{t.local.horarios}</h3>
        <p class="loc__nota">{t.local.horariosNota}</p>
        <h3 class="loc__h tracado">{t.local.servicos}</h3>
        <ul class="serv">
          {servicos.map((s) => <li><Icone nome={s.id} class="serv__i" /><span>{s.nome}</span></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- abertura ---------- */
  .hero { padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 6vw, 5rem); }
  .hero__grade { display: grid; gap: 2.25rem; align-items: center; }
  .hero__conteudo { display: grid; gap: 1.5rem; justify-items: start; }
  .hero h1 { max-width: 20ch; font-size: clamp(2.5rem, 1.3rem + 3.2vw, 4rem); line-height: 1.04; }
  .hero .lead { margin: 0; max-width: 36ch; color: var(--claro-sobre-preto); }
  .hero__acoes { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: .5rem; }
  .hero__janela { --placa-borda: clamp(1.1rem, 3vw, 1.9rem); min-width: 0; }
  .hero__midia { position: relative; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--raio); background: var(--tinta); }
  .hero__midia :global(.quadro) { position: absolute; inset: 0; height: 100%; border-radius: 0; aspect-ratio: auto !important; }
  .hero__midia :global(.quadro__in) { padding: 2rem 1.6rem; }
  .hero__legenda { position: absolute; z-index: 2; left: .75rem; top: .75rem; margin: 0; padding: .4rem .7rem; background: rgb(0 0 0 / .72); color: var(--branco); font-size: .75rem; font-weight: 600; letter-spacing: .02em; line-height: 1.2; border-radius: var(--raio); max-width: calc(100% - 1.5rem); }
  @media (min-width: 62rem) {
    .hero { min-height: max(34rem, calc(100svh - 7.5rem)); display: grid; align-items: center; }
    .hero__grade { grid-template-columns: 6fr 7fr; gap: clamp(2.5rem, 4.5vw, 4.5rem); }
  }

  /* ritmo: as seções não têm a mesma altura nem a mesma composição */
  .sec--ampla { padding-block: clamp(5.5rem, 11vw, 10.5rem); }
  .sec--compacta { padding-block: clamp(3.5rem, 7vw, 6rem); }

  /* ---------- história: foto alta fixa, texto longo e uma segunda foto larga ---------- */
  .hist { display: grid; gap: 2.5rem; align-items: start; }
  .hist__txt { display: grid; gap: 1.4rem; justify-items: start; }
  .hist__txt h2 { font-size: clamp(2.4rem, 1.4rem + 3.6vw, 4.5rem); max-width: 14ch; }
  .hist__txt .lead { margin: 0; }
  .hist__txt :global(.quadro) { width: 100%; margin-top: 1.25rem; }
  @media (min-width: 62rem) { .hist { grid-template-columns: 5fr 6fr; gap: 6rem; } .hist__foto { position: sticky; top: calc(var(--hd-h) + 2rem); } }

  /* ---------- experiência: sumário da carta + fotos escalonadas ---------- */
  .exp { display: grid; gap: 3rem; align-items: start; }
  .exp__txt { display: grid; gap: 1.1rem; justify-items: start; }
  .exp__txt .lead { margin: 0; max-width: 34ch; }
  .carta { width: 100%; margin: 1.25rem 0 .25rem; border-top: 1px solid var(--linha); }
  .carta li { border-bottom: 1px solid var(--linha); }
  .carta__l { display: flex; align-items: baseline; gap: .75rem; min-height: 3.5rem; padding: .7rem 0; text-decoration: none; color: var(--tinta); }
  .carta__n { font: 400 clamp(1.5rem, 1.2rem + 1vw, 2rem)/1.15 var(--f-titulo); }
  .carta__l::after { content: ''; order: 1; flex: 1; align-self: end; margin-bottom: .55em; border-bottom: 1px dotted var(--texto-2); min-width: 1rem; }
  .carta__p { order: 2; font-size: .9rem; color: var(--texto-2); white-space: nowrap; }
  @media (hover: hover) { .carta__l { transition: padding-left .35s var(--ease-out), color .3s var(--ease); } .carta__l:hover { padding-left: .6rem; color: var(--verde-texto); } }
  .exp__extra { margin: 0; }
  .exp__fotos { display: grid; gap: 1rem; align-items: start; }
  .exp__fotos :global(.quadro) { aspect-ratio: 3 / 2 !important; }
  @media (min-width: 62rem) {
    .exp { grid-template-columns: 5fr 6fr; gap: 5.5rem; }
    .exp__txt { position: sticky; top: calc(var(--hd-h) + 2rem); }
    .exp__fotos { grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    .dest--1 { grid-column: 1; grid-row: 1 / span 2; }
    .dest--1 :global(.quadro) { aspect-ratio: 4 / 5 !important; }
    .dest--2 :global(.quadro), .dest--3 :global(.quadro) { aspect-ratio: 3 / 2 !important; }
    .dest--2 { grid-column: 2; margin-top: 4rem; }
    .dest--3 { grid-column: 2; }
  }

  /* ---------- ambiente: o texto é uma célula do mosaico ---------- */
  .amb__grade { display: grid; gap: 1rem; }
  .amb__txt { display: grid; gap: 1rem; justify-items: start; padding-block: 0 1.5rem; }
  .amb__txt .lead { margin: 0; max-width: 32ch; }
  @media (min-width: 52rem) {
    .amb__grade { grid-template-columns: repeat(12, 1fr); gap: 1.25rem; align-items: start; }
    .amb__txt { grid-column: 1 / span 5; grid-row: 1; align-self: end; padding: 0 2rem 1rem 0; }
    .amb__grade :global(.amb__q--1) { grid-column: 6 / span 7; grid-row: 1; }
    .amb__grade :global(.amb__q--2) { grid-column: 1 / span 4; grid-row: 2 / span 2; }
    .amb__grade :global(.amb__q--3) { grid-column: 5 / span 3; grid-row: 2 / span 2; align-self: start; }
    .amb__grade :global(.amb__q--4) { grid-column: 8 / span 5; grid-row: 2 / span 2; align-self: end; }
  }

  /* ---------- avaliações ---------- */
  .av { padding-block: clamp(4.5rem, 10vw, 9rem); }
  .av__in { display: grid; gap: clamp(2.5rem, 5vw, 4rem); justify-items: start; }
  .av__placa { --placa-borda: clamp(1.25rem, 3vw, 2rem); width: fit-content; max-width: 100%; padding: clamp(.5rem, 2vw, 1.5rem); }
  .mega { margin: 0; max-width: 18ch; font: 400 clamp(2.4rem, 1rem + 5.2vw, 5.5rem)/1.05 var(--f-titulo); color: var(--branco); text-wrap: balance; }
  .mega__nota { color: var(--verde-claro); }
  .temas { width: 100%; display: grid; gap: 2rem; border-top: 1px solid rgb(255 255 255 / .25); padding-top: 1.75rem; }
  .tema__t { margin: 0 0 .9rem; font-family: var(--f-texto); font-size: var(--t-mini); line-height: 1; color: var(--verde-claro); }
  .tema li { padding: .45rem 0; font: 400 1.3rem/1.3 var(--f-titulo); color: var(--branco); }
  .av__fonte { margin: 0; font-size: .875rem; max-width: 70ch; }
  @media (min-width: 52rem) { .temas { grid-template-columns: repeat(3, 1fr); gap: 3rem; } }

  /* ---------- reservas: a placa emoldura o formulário ---------- */
  .res { display: grid; gap: 2.5rem; align-items: start; }
  .res__txt { display: grid; gap: 1rem; justify-items: start; }
  .res__txt .lead { margin: 0; max-width: 30ch; }
  .res__form { --placa-borda: 1.25rem; }
  @media (min-width: 62rem) { .res { grid-template-columns: .8fr 1.2fr; gap: 5rem; } .res__txt { position: sticky; top: calc(var(--hd-h) + 2rem); } .res__form { --placa-borda: 1.75rem; } }

  /* ---------- localização e contato ---------- */
  .loc { display: grid; gap: 3rem; align-items: start; }
  .loc__desc { color: var(--texto-2); }
  .loc address { font-style: normal; display: grid; gap: 1.2rem; justify-items: start; margin-top: 2rem; }
  .loc address .lead { margin: 0; }
  .loc__tel { display: inline-block; min-height: 2.75rem; font-weight: 500; font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3rem); line-height: 1.1; text-decoration: none; color: var(--tinta); }
  @media (hover: hover) { .loc__tel { transition: color .3s var(--ease); } .loc__tel:hover { color: var(--verde-texto); } }
  .loc__acoes { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  .loc__h { margin: 0 0 .8rem; color: var(--tinta); font-family: var(--f-texto); font-size: var(--t-mini); line-height: 1; }
  .loc__info > .loc__h ~ .loc__h { margin-top: 2.25rem; }
  .loc__nota { margin: 0; color: var(--texto-2); max-width: 44ch; padding-top: .9rem; border-top: 1px solid var(--areia); }
  .serv { display: grid; border-top: 1px solid var(--areia); }
  .serv li { display: flex; align-items: center; gap: 1.1rem; padding: 1rem 0; border-bottom: 1px solid var(--areia); font: 400 1.35rem/1.2 var(--f-titulo); color: var(--tinta); }
  .serv :global(.serv__i) { width: 1.75rem; height: 1.75rem; color: var(--verde-texto); flex: none; }
  @media (min-width: 62rem) { .loc { grid-template-columns: 1fr 1fr; gap: 7rem; } }
</style>
