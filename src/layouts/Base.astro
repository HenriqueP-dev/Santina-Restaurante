---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BarraLigar from '../components/BarraLigar.astro';
import { negocio, textos, seo } from '../conteudo/ativo';

interface Props { title?: string; description?: string }
const {
  title = `${negocio.nome} · Gastronomia em ${negocio.cidade}, ${negocio.uf}`,
  description = seo.descricao,
} = Astro.props;

// Dados estruturados (Schema.org): só fatos da documentação. Sem nota de avaliação (o Google não aceita
// avaliação autodeclarada) e sem horários, que ainda não foram confirmados.
const dados = {
  '@context': 'https://schema.org', '@type': 'Restaurant', name: negocio.nome,
  servesCuisine: 'Gastronomia contemporânea de inspiração italiana',
  address: { '@type': 'PostalAddress', streetAddress: negocio.endereco, addressLocality: negocio.cidade, addressRegion: negocio.uf, postalCode: negocio.cep, addressCountry: 'BR' },
  telephone: negocio.telefoneIntl,
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    {!seo.indexar && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(dados)} />
    <!-- Movimento só quando permitido. Se o script de animação não carregar em 2,5 s, o conteúdo aparece mesmo assim. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var r = document.documentElement; r.classList.add('mov');
        setTimeout(function () { if (!r.classList.contains('mov-ok')) r.classList.remove('mov'); }, 2500);
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    {textos.aviso && <aside class="aviso" aria-label="Aviso do projeto">{textos.aviso}</aside>}
    <Header />
    <main id="conteudo"><slot /></main>
    <Footer />
    <BarraLigar />
    <script>import '../scripts/movimento';</script>
  </body>
</html>
<style is:global>
  .aviso { padding: .55rem var(--gutter); background: var(--creme); color: var(--texto-2); font-size: .8rem; line-height: 1.3; text-align: center; }
</style>
